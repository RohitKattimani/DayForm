# Copy this file to .env and replace every CHANGE_ME value.
# IMPORTANT: rotate the PostgreSQL and Kafka credentials shared in chat before using this project.

# Aiven PostgreSQL (use the rotated password; keep sslmode=require)
DATABASE_URL=postgresql+psycopg://avnadmin:CHANGE_ME@pg-2628cdd8-hackbrivenstore.d.aivencloud.com:11617/defaultdb?sslmode=require

# Aiven Kafka (SASL_SSL). Use the SASL service user credentials from Aiven.
KAFKA_BOOTSTRAP_SERVERS=kafka-89ec45-hackbrivenstore.a.aivencloud.com:11630
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=CHANGE_ME
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# Download the CA certificate from Aiven Quick connect and save it as certs/ca.pem.
# Docker path is /certs/ca.pem; leave blank only if your runtime trusts the broker CA already.
KAFKA_CA_PATH=/certs/ca.pem
KAFKA_TOPIC=store.events
KAFKA_GROUP_ID=dayform-inventory-sync-v1

# Aiven OpenSearch: set the full https://USER:PASSWORD@HOST:PORT service URI from Overview.
OPENSEARCH_URL=
OPENSEARCH_INDEX=dayform-products-v1

# App options
ENVIRONMENT=development
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
